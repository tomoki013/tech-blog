---
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getArticlesPath, getWorksPath } from "@/i18n/config";
import { getUi } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getArticlesWithPaths } from "@/lib/articles";
import { getFeaturedProjects } from "@/lib/projects";
import { safeJsonLd } from "@/lib/seo";
import { siteConfig } from "@/site.config";

const locale = "ja";
const t = getUi(locale);
const articles = (await getArticlesWithPaths(locale)).slice(0, 5);
const featuredProjects = getFeaturedProjects();

const focusAreas = [
  "パフォーマンス最適化 / Core Web Vitals",
  "AI 活用プロダクト開発",
  "静的サイト設計 / エッジデプロイ",
  "Web フロントエンド開発",
  "Developer Experience (DX)",
];

const websiteJsonLd = safeJsonLd({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name[locale],
  url: siteConfig.url,
  description: siteConfig.description[locale],
  inLanguage: "ja",
  author: { "@type": "Person", name: siteConfig.author },
});
---

<BaseLayout
  title={siteConfig.name[locale]}
  description={siteConfig.description[locale]}
  locale={locale}
  canonicalPath="/"
  alternateHref="/en/"
  alternateLocales={[
    { locale: "ja", path: "/" },
    { locale: "en", path: "/en/" },
    { locale: "x-default", path: "/" },
  ]}
  jsonLd={websiteJsonLd}
>
  <section class="hero">
    <div class="hero__text">
      <p class="eyebrow">Engineering Growth Log</p>
      <h1>{siteConfig.name[locale]}</h1>
      <p class="hero__role">
        <span>Frontend Engineer</span>
        <span class="hero__role-sep" aria-hidden="true">/</span>
        <span>Web Developer</span>
      </p>
      <p class="hero__lead">{t.topLead}</p>
      <div class="hero__cta">
        <a href={getArticlesPath(locale)} class="hero__cta-primary" data-astro-prefetch>{t.readArticles}</a>
        <a href={getWorksPath(locale)} class="hero__cta-secondary" data-astro-prefetch>{t.seeMyWorks}</a>
      </div>
    </div>
    <img
      class="hero__profile"
      src="/icon-256.webp"
      srcset="/icon-256.webp 256w, /icon-512.webp 512w"
      sizes="179px"
      alt="Tomokichi profile"
      width="179"
      height="179"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </section>

  <section aria-labelledby="featured-works">
    <div class="section-header">
      <h2 id="featured-works">{t.featuredWorks}</h2>
      <a href={getWorksPath(locale)} data-astro-prefetch>{t.seeAllWorks}</a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
  </section>

  <section aria-labelledby="focus-areas" class="focus-areas">
    <h2 id="focus-areas">{t.focusAreas}</h2>
    <ul class="focus-areas__list">
      {focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </section>

  <section aria-labelledby="latest-articles">
    <div class="section-header">
      <h2 id="latest-articles">{t.latestArticles}</h2>
      <a href={getArticlesPath(locale)}>{t.allArticles}</a>
    </div>
    <div class="article-list">
      {articles.length === 0 ? (
        <p>{t.noArticles}</p>
      ) : (
        articles.map(({ article, href }) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={href}
            publishedAt={article.data.publishedAt}
            tags={article.data.tags}
            locale={locale}
          />
        ))
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 4rem;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .hero__role {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero__role-sep {
    font-weight: 300;
    opacity: 0.5;
  }

  .hero__lead {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: clamp(1.04rem, 2vw, 1.14rem);
    line-height: 1.9;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .hero__cta-primary,
  .hero__cta-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.72rem 1.5rem;
    border-radius: 0.65rem;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease,
      color 0.18s ease;
  }

  .hero__cta-primary::after,
  .hero__cta-secondary::after {
    content: "→";
    margin-left: 0.45rem;
    display: inline-block;
    transition: transform 0.18s ease;
  }

  .hero__cta-primary:hover::after,
  .hero__cta-secondary:hover::after {
    transform: translateX(4px);
  }

  /* Light mode: dark solid button */
  .hero__cta-primary {
    background: var(--color-text);
    color: var(--color-bg);
    box-shadow: 0 2px 12px rgb(0 0 0 / 0.12);
  }

  .hero__cta-primary:hover {
    background: var(--color-text);
    color: var(--color-bg);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.18);
  }

  /* Dark mode: orange button with dark text (contrast ratio ~6.7:1) */
  :global(.dark) .hero__cta-primary {
    background: #f97316;
    color: #111;
    box-shadow: 0 2px 16px rgb(249 115 22 / 0.28);
  }

  :global(.dark) .hero__cta-primary:hover {
    background: #fb923c;
    color: #111;
    transform: translateY(-2px);
    box-shadow: 0 6px 28px rgb(249 115 22 / 0.45);
  }

  .hero__cta-secondary {
    background: transparent;
    border: 1.5px solid var(--color-border);
    color: var(--color-text);
  }

  .hero__cta-secondary:hover {
    border-color: var(--color-text-muted);
    color: var(--color-text);
    background: var(--color-surface);
    transform: translateY(-1px);
  }

  .hero__profile {
    width: 179px;
    height: 179px;
    border-radius: 9999px;
    object-fit: cover;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-header h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .section-header a {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    white-space: nowrap;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .focus-areas {
    margin-bottom: 4rem;
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
  }

  .focus-areas h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.3rem, 3vw, 1.6rem);
    letter-spacing: -0.03em;
  }

  .focus-areas__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .focus-areas__list li {
    font-size: 0.85rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    background: var(--color-surface-muted);
  }

  .article-list {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 1.5rem 0 2.5rem;
    }

    .hero__profile {
      order: -1;
      width: 96px;
      height: 96px;
    }

    .section-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
