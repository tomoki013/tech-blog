---
import { getUi } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = "ja";
const t = getUi(locale);
---

<BaseLayout
  title={t.license}
  description="ともきちのエンジニア成長記におけるソースコード、記事、写真、画像、その他コンテンツのライセンスと権利について説明します。"
  locale={locale}
  canonicalPath="/license/"
  alternateHref="/en/license/"
  alternateLocales={[
    { locale: "ja", path: "/license/" },
    { locale: "en", path: "/en/license/" },
    { locale: "x-default", path: "/license/" },
  ]}
>
  <section class="page-header">
    <p class="eyebrow">License</p>
    <h1>{t.license}</h1>
  </section>

  <section class="prose">
    <div class="prose__section">
      <h2>ソースコード</h2>
      <p>
        このサイトのソースコードは、<strong>MIT License</strong> のもとで公開しています。
      </p>
      <p>
        MIT License の詳細は、リポジトリ内の <code>LICENSE</code> ファイルを参照してください。
      </p>
    </div>

    <div class="prose__section">
      <h2>記事・コンテンツ</h2>
      <p>
        記事本文、テキストコンテンツ、写真、画像、アイコン、OGP 画像、デザイン素材その他コード以外のコンテンツは、明示がない限り MIT License の対象外です。
      </p>
      <p>
        これらのコンテンツに関する一切の権利は <strong>Tomokichi</strong> が留保します。
      </p>
    </div>

    <div class="prose__section">
      <h2>著作権・禁止事項</h2>
      <p>
        引用など法令上認められる場合を除き、許可なく複製・転載・再配布・改変・商業利用することはできません。
      </p>
      <p>
        二次利用を希望される場合は、フッターのリンクよりご連絡ください。
      </p>
    </div>

    <div class="prose__section">
      <h2>第三者の素材</h2>
      <p>
        使用しているライブラリ、ツール、依存パッケージなどには、それぞれのライセンスが適用されます。
      </p>
    </div>
  </section>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: 4rem;
      width: 100%;
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2.35rem, 8vw, 5.2rem);
      line-height: 0.98;
      letter-spacing: -0.07em;
    }

    .eyebrow {
      margin: 0 0 0.8rem;
      color: var(--color-text-muted);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .prose {
      max-width: 42rem;
      margin-inline: auto;
      line-height: 1.9;
    }

    .prose__section + .prose__section {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .prose__section h2 {
      margin: 0 0 1rem;
      font-size: 1.35rem;
      letter-spacing: -0.035em;
    }

    .prose__section p {
      margin: 0 0 0.75rem;
      color: var(--color-text-muted);
    }

    .prose__section p:last-child {
      margin-bottom: 0;
    }

    code {
      border: 1px solid var(--color-border);
      border-radius: 0.4rem;
      background: var(--color-surface-muted);
      padding: 0.1rem 0.32rem;
      font-size: 0.9em;
    }
  </style>
</BaseLayout>
