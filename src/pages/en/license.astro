---
import { getUi } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";

const locale = "en";
const t = getUi(locale);
---

<BaseLayout
  title={t.license}
  description="License and rights information for the source code, articles, photographs, images, and other content of Tomokichi's Engineering Growth Log."
  locale={locale}
  canonicalPath="/en/license/"
  alternateHref="/license/"
  alternateLocales={[
    { locale: "ja", path: "/license/" },
    { locale: "en", path: "/en/license/" },
    { locale: "x-default", path: "/license/" },
  ]}
>
  <section class="page-header">
    <p class="eyebrow">License</p>
    <h1>{t.license}</h1>
  </section>

  <section class="prose">
    <div class="prose__section">
      <h2>Source code</h2>
      <p>
        The source code of this site is licensed under the <strong>MIT License</strong>.
      </p>
      <p>
        See the <code>LICENSE</code> file in the repository for details.
      </p>
    </div>

    <div class="prose__section">
      <h2>Content</h2>
      <p>
        Articles, text content, photographs, images, icons, OGP images, design assets, and other non-code content are not covered by the MIT License unless explicitly stated otherwise.
      </p>
      <p>
        All rights to such content are reserved by <strong>Tomokichi</strong>.
      </p>
    </div>

    <div class="prose__section">
      <h2>Copyright and restrictions</h2>
      <p>
        You may not reproduce, redistribute, modify, or use these materials for commercial purposes without permission, except where permitted by applicable law (e.g., quotation).
      </p>
      <p>
        For reuse requests, please reach out via the links in the footer.
      </p>
    </div>

    <div class="prose__section">
      <h2>Third-party materials</h2>
      <p>
        Third-party libraries, tools, and dependencies are subject to their respective licenses.
      </p>
    </div>
  </section>

  <style>
    .page-header {
      text-align: center;
      margin-bottom: 4rem;
      width: 100%;
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2.35rem, 8vw, 5.2rem);
      line-height: 0.98;
      letter-spacing: -0.07em;
    }

    .eyebrow {
      margin: 0 0 0.8rem;
      color: var(--color-text-muted);
      font-size: 0.88rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .prose {
      max-width: 42rem;
      margin-inline: auto;
      line-height: 1.9;
    }

    .prose__section + .prose__section {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }

    .prose__section h2 {
      margin: 0 0 1rem;
      font-size: 1.35rem;
      letter-spacing: -0.035em;
    }

    .prose__section p {
      margin: 0 0 0.75rem;
      color: var(--color-text-muted);
    }

    .prose__section p:last-child {
      margin-bottom: 0;
    }

    code {
      border: 1px solid var(--color-border);
      border-radius: 0.4rem;
      background: var(--color-surface-muted);
      padding: 0.1rem 0.32rem;
      font-size: 0.9em;
    }
  </style>
</BaseLayout>
