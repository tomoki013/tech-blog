---
import { getUi } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { absoluteUrl, safeJsonLd } from "@/lib/seo";
import { siteConfig } from "@/site.config";

const locale = "ja";
const t = getUi(locale);

const personJsonLd = safeJsonLd({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Tomokichi",
  url: absoluteUrl("/about/"),
  description: siteConfig.bio[locale],
  jobTitle: "Frontend Engineer",
  sameAs: [
    "https://x.com/tomokichi178694",
    "https://github.com/tomoki013",
    "https://zenn.dev/tomokichi",
    "https://www.linkedin.com/in/tomoki-takagi-5b08a738b/",
  ],
});
---

<BaseLayout
  title={`About — ${siteConfig.name[locale]}`}
  description="ともきちのプロフィールと、個人開発・Web開発・AI活用・設計・運用改善への取り組みを紹介します。"
  locale={locale}
  canonicalPath="/about/"
  alternateHref="/en/about/"
  alternateLocales={[
    { locale: "ja", path: "/about/" },
    { locale: "en", path: "/en/about/" },
    { locale: "x-default", path: "/about/" },
  ]}
  jsonLd={personJsonLd}
>
  <article class="about">
    <header class="about__header">
      <p class="eyebrow">About</p>
      <h1 class="about__title">ともきちについて</h1>
      <div class="about__intro">
        <img
          class="about__avatar"
          src="/icon-256.webp"
          srcset="/icon-256.webp 256w, /icon-512.webp 512w"
          sizes="120px"
          alt="Tomokichi profile"
          width="120"
          height="120"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="about__intro-text">
          <p class="about__role">Frontend Engineer · Web Developer</p>
          <p class="about__bio">
            ともきちです。フロントエンドエンジニアとして、TypeScript・Astro・Next.js を中心に
            個人開発・ブログ・ツールを作りながら、学んだことを記録・発信しています。
          </p>
        </div>
      </div>
    </header>

    <section class="about__section" aria-labelledby="what-i-build">
      <h2 id="what-i-build">{t.whatIBuild}</h2>
      <ul>
        <li><strong>Web アプリ</strong> — AI を活用した旅行計画アプリなど、実用的なプロダクト</li>
        <li><strong>ブログ</strong> — 技術の知見を記録するエンジニア成長記と、実運用中の旅行ブログ</li>
        <li><strong>開発ツール</strong> — 日常の開発作業を効率化するユーティリティ</li>
      </ul>
    </section>

    <section class="about__section" aria-labelledby="engineering-interests">
      <h2 id="engineering-interests">{t.engineeringInterests}</h2>
      <ul>
        <li>パフォーマンス最適化と Core Web Vitals の計測・改善</li>
        <li>静的サイト設計とエッジデプロイ（Cloudflare Workers）</li>
        <li>AI 活用とプロンプト設計によるプロダクト開発</li>
        <li>Developer Experience（開発者体験）の改善</li>
        <li>アクセシビリティと SEO の設計段階での組み込み</li>
      </ul>
    </section>

    <section class="about__section" aria-labelledby="current-focus">
      <h2 id="current-focus">{t.currentFocus}</h2>
      <ul>
        <li>Astro ベースの静的サイトの設計最適化と継続的なパフォーマンス改善</li>
        <li>AI 駆動の旅行計画アプリ「Tabidea」の機能拡張と UX 改善</li>
      </ul>
    </section>

    <section class="about__section" aria-labelledby="my-tech-stack">
      <h2 id="my-tech-stack">{t.myTechStack}</h2>
      <ul class="about__stack">
        {["TypeScript", "Astro", "Next.js", "React", "Tailwind CSS", "Cloudflare Workers", "Supabase", "Biome"].map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>
    </section>

    <section class="about__section" aria-labelledby="contact-section">
      <h2 id="contact-section">{t.contactMe}</h2>
      <div class="contact-cards">
        <a
          href="https://x.com/tomokichi178694"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card"
          aria-label="X で連絡する"
        >
          <div class="contact-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </div>
          <div class="contact-card__content">
            <p class="contact-card__name">X で連絡する</p>
            <p class="contact-card__handle">@tomokichi178694</p>
          </div>
        </a>

        <a
          href="https://github.com/tomoki013"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card"
          aria-label="GitHub プロフィールを見る"
        >
          <div class="contact-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <div class="contact-card__content">
            <p class="contact-card__name">GitHub プロフィール</p>
            <p class="contact-card__handle">@tomoki013</p>
          </div>
        </a>

        <a
          href="https://zenn.dev/tomokichi"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card"
          aria-label="Zenn プロフィールを見る"
        >
          <div class="contact-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M.264 23.771h4.984c.264 0 .498-.147.645-.352L19.614.874c.147-.234.176-.498.029-.733A.765.765 0 0 0 18.998 0H14.01c-.293 0-.527.147-.673.41L.03 23.039c-.117.234-.088.527.088.703.118.088.234.029.146.029zm10.786 0h12.673c.322 0 .615-.176.762-.44a.77.77 0 0 0-.03-.82l-6.35-10.28c-.146-.235-.41-.382-.702-.382h-4.985c-.293 0-.556.147-.703.382l-6.35 10.28a.783.783 0 0 0-.029.82.832.832 0 0 0 .762.44h4.952z"/>
            </svg>
          </div>
          <div class="contact-card__content">
            <p class="contact-card__name">Zenn プロフィール</p>
            <p class="contact-card__handle">@tomokichi</p>
          </div>
        </a>

        <a
          href="https://www.linkedin.com/in/tomoki-takagi-5b08a738b/"
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card"
          aria-label="LinkedIn プロフィールを見る"
        >
          <div class="contact-card__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div class="contact-card__content">
            <p class="contact-card__name">LinkedIn プロフィール</p>
            <p class="contact-card__handle">Tomoki Takagi</p>
          </div>
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    width: min(100%, 46rem);
    margin-inline: auto;
  }

  .about__header {
    margin-bottom: 3rem;
  }

  .eyebrow {
    margin: 0 0 0.8rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about__title {
    margin: 0 0 1.5rem;
    font-size: clamp(2.35rem, 8vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.07em;
  }

  .about__intro {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
  }

  .about__avatar {
    width: 120px;
    height: 120px;
    border-radius: 9999px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .about__intro-text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about__role {
    display: inline-flex;
    align-items: center;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .about__bio {
    margin: 0;
    font-size: 1.06rem;
    line-height: 1.85;
    color: color-mix(in srgb, var(--color-text) 88%, var(--color-text-muted));
  }

  @media (max-width: 560px) {
    .about__intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }
  }

  .about__section {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .about__section h2 {
    margin: 0 0 0.9rem;
    font-size: 1.45rem;
    letter-spacing: -0.03em;
  }

  .about__section > ul {
    padding-left: 1.4rem;
    margin: 0;
  }

  .about__section li {
    margin-bottom: 0.55rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text) 88%, var(--color-text-muted));
  }

  .about__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .about__stack li {
    font-size: 0.82rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    color: var(--color-text-muted);
    background: var(--color-surface-muted);
    margin: 0;
    line-height: 1.5;
  }

  .contact-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.25rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .contact-card:hover {
    border-color: var(--color-link);
    box-shadow: 0 4px 16px rgb(28 27 24 / 0.08);
  }

  .contact-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    background: var(--color-surface-muted);
    color: var(--color-text);
    flex-shrink: 0;
  }

  .contact-card__name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .contact-card__handle {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
