---
import type { MarkdownHeading } from "astro";
import ArticleExport from "@/components/ArticleExport.astro";
import RelatedProjects from "@/components/RelatedProjects.astro";
import WebMcp from "@/components/WebMcp.astro";
import type { ProjectId } from "@/data/project-ids";
import type { Project } from "@/data/projects";
import type { Locale } from "@/i18n/config";
import { getUi } from "@/i18n/ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate } from "@/lib/seo";
import { siteConfig } from "@/site.config";

interface AlternateLocale {
  locale: Locale | "x-default";
  path: string;
}

interface AdjacentArticle {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  alternateHref: string;
  alternateLocales: AlternateLocale[];
  publishedAt: Date;
  updatedAt?: Date;
  tags: string[];
  projectIds?: ProjectId[];
  relatedProjects?: Project[];
  prevArticle?: AdjacentArticle;
  nextArticle?: AdjacentArticle;
  toc?: MarkdownHeading[];
  mdHref: string;
  jsonHref: string;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  alternateHref,
  alternateLocales,
  publishedAt,
  updatedAt,
  tags,
  projectIds = [],
  relatedProjects = [],
  prevArticle,
  nextArticle,
  toc = [],
  mdHref,
  jsonHref,
} = Astro.props;
const t = getUi(locale);
const articleUrl = `${siteConfig.url}${canonicalPath}`;
const filteredToc = toc.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasToc = filteredToc.length > 0;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={canonicalPath}
  alternateHref={alternateHref}
  type="article"
  alternateLocales={alternateLocales}
>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={mdHref} title={title} />
    <link rel="alternate" type="application/json" href={jsonHref} title={title} />
  </Fragment>

  <article class="article-detail">
    <header class="article-detail__header">
      <h2>{title}</h2>
      <div class="article-detail__dates">
        <time datetime={publishedAt.toISOString()}>{t.published}: {formatDate(publishedAt, locale)}</time>
        {updatedAt && (
          <time datetime={updatedAt.toISOString()}>{t.updated}: {formatDate(updatedAt, locale)}</time>
        )}
      </div>
      <div class="article-detail__meta">
        <div class="article-detail__meta-left">
          {tags.length > 0 && (
            <ul class="tag-list" aria-label={t.tags}>
              {tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </div>
        <div class="article-detail__share">
          <a
            href={`https://x.com/intent/tweet?url=${encodeURIComponent(articleUrl)}&text=${encodeURIComponent(title)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="share-link"
            aria-label="Share on X"
            title="Share on X"
          >
            <svg
              class="share-icon"
              viewBox="0 0 24 24"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="article-detail__export">
        <ArticleExport mdHref={mdHref} jsonHref={jsonHref} locale={locale} />
      </div>

      {hasToc && (
        <details class="toc-header" open>
          <summary class="toc-header__summary">
            <svg class="toc-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="5" x2="17" y2="5"/>
              <line x1="3" y1="10" x2="17" y2="10"/>
              <line x1="3" y1="15" x2="12" y2="15"/>
            </svg>
            <span>{t.toc}</span>
            <svg class="toc-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="5 8 10 13 15 8"/>
            </svg>
          </summary>
          <nav class="toc-header__body" aria-label={t.toc}>
            <ol class="toc-list">
              {filteredToc.map((h) => (
                <li class:list={["toc-item", `toc-item--${h.depth}`]}>
                  <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
    </header>

    {hasToc && <div id="toc-sentinel" aria-hidden="true" />}

    <div class="article-content">
      <slot />
    </div>

    {hasToc && <div id="toc-end-sentinel" aria-hidden="true" />}

    {(prevArticle || nextArticle) && (
      <nav class="article-nav" aria-label="前後の記事">
        <div class="article-nav__inner">
          <div class="article-nav__item article-nav__item--prev">
            {prevArticle && (
              <a href={prevArticle.href} class="article-nav__link">
                <span class="article-nav__label">← {t.prevArticle}</span>
                <span class="article-nav__title">{prevArticle.title}</span>
              </a>
            )}
          </div>
          <div class="article-nav__item article-nav__item--next">
            {nextArticle && (
              <a href={nextArticle.href} class="article-nav__link">
                <span class="article-nav__label">{t.nextArticle} →</span>
                <span class="article-nav__title">{nextArticle.title}</span>
              </a>
            )}
          </div>
        </div>
      </nav>
    )}

    <div class="article-detail__footer">
      <div class="article-detail__profile">
        <img
          src={siteConfig.profileImage}
          alt={siteConfig.author}
          class="article-detail__avatar"
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
        />
        <div class="article-detail__author-info">
          <span class="article-detail__author-name">{siteConfig.author}</span>
          <p class="article-detail__author-bio">{siteConfig.bio[locale]}</p>
        </div>
      </div>
      <RelatedProjects projects={relatedProjects} locale={locale} />
    </div>
  </article>

  <WebMcp mdHref={mdHref} title={title} />

  {hasToc && (
    <button
      id="toc-fab"
      class="toc-fab"
      type="button"
      aria-label={t.toc}
      aria-haspopup="dialog"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="9" y1="6" x2="20" y2="6"/>
        <line x1="9" y1="12" x2="20" y2="12"/>
        <line x1="9" y1="18" x2="20" y2="18"/>
        <circle cx="4" cy="6" r="1" fill="currentColor" stroke="none"/>
        <circle cx="4" cy="12" r="1" fill="currentColor" stroke="none"/>
        <circle cx="4" cy="18" r="1" fill="currentColor" stroke="none"/>
      </svg>
      <span class="toc-fab__label">{t.toc}</span>
    </button>
  )}

  {hasToc && (
    <dialog id="toc-dialog" class="toc-dialog" aria-labelledby="toc-dialog-title">
      <div class="toc-dialog__handle" aria-hidden="true"></div>
      <div class="toc-dialog__header">
        <span id="toc-dialog-title" class="toc-dialog__title">
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="5" x2="17" y2="5"/>
            <line x1="3" y1="10" x2="17" y2="10"/>
            <line x1="3" y1="15" x2="12" y2="15"/>
          </svg>
          {t.toc}
        </span>
        <button id="toc-close" class="toc-dialog__close" type="button" aria-label={t.closeToc}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <nav class="toc-dialog__body" aria-label={t.toc}>
        <ol class="toc-list toc-list--dialog">
          {filteredToc.map((h) => (
            <li class:list={["toc-item", `toc-item--${h.depth}`]}>
              <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </dialog>
  )}
</BaseLayout>

<script>
  function setupToc() {
    const fab = document.getElementById("toc-fab") as HTMLButtonElement | null;
    const sentinel = document.getElementById("toc-sentinel");
    const endSentinel = document.getElementById("toc-end-sentinel");
    const dialog = document.getElementById("toc-dialog") as HTMLDialogElement | null;
    const closeBtn = document.getElementById("toc-close");
    if (!fab || !sentinel || !dialog) return;

    const dlg = dialog;
    const sbw = window.innerWidth - document.documentElement.clientWidth;

    function openToc() {
      dlg.showModal();
      document.body.style.paddingRight = sbw + "px";
      document.body.style.overflow = "hidden";
    }
    function closeToc() {
      document.body.style.paddingRight = "";
      document.body.style.overflow = "";
      dlg.close();
    }

    fab.addEventListener("click", openToc);
    closeBtn?.addEventListener("click", closeToc);
    dlg.addEventListener("click", (e) => { if (e.target === dlg) closeToc(); });
    dlg.querySelectorAll("a").forEach((a) => a.addEventListener("click", closeToc));

    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc-list a")
    );
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>(".article-content h2[id], .article-content h3[id]")
    );

    let rafId = 0;
    let prevActiveId = "";

    // Drive FAB visibility from scroll position rather than an IntersectionObserver:
    // the sentinel is a zero-height node, so an observer only fires at the exact
    // boundary crossing and can miss the "scrolled past" state. Evaluating the
    // geometry every frame is reliable and also avoids showing the FAB at the top
    // when a tall header pushes the sentinel below the fold.
    // Arrow functions (not hoisted declarations) so the non-null narrowing of
    // `fab` / `sentinel` from the guard above flows into these closures.
    const updateFab = () => {
      const startTop = sentinel.getBoundingClientRect().top;
      const endTop = endSentinel
        ? endSentinel.getBoundingClientRect().top
        : Number.POSITIVE_INFINITY;
      const show = startTop < 0 && endTop > window.innerHeight;
      fab.classList.toggle("toc-fab--visible", show);
    };

    const applyHighlight = () => {
      if (!headings.length) return;
      const THRESHOLD = 100;
      let activeId = "";
      for (const h of headings) {
        if (h.getBoundingClientRect().top < THRESHOLD) activeId = h.id;
        else break;
      }
      if (activeId === prevActiveId) return;
      prevActiveId = activeId;
      for (const link of tocLinks) {
        link.classList.toggle(
          "toc-link--active",
          decodeURIComponent(link.hash) === "#" + activeId
        );
      }
    };

    const onFrame = () => {
      rafId = 0;
      updateFab();
      applyHighlight();
    };

    const onScroll = () => {
      if (rafId) return;
      rafId = requestAnimationFrame(onFrame);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onFrame();

    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("scroll", onScroll);
      cancelAnimationFrame(rafId);
    }, { once: true });
  }

  document.addEventListener("astro:page-load", setupToc);
</script>

<style>
  .article-detail {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
  }

  .article-detail__header {
    margin-bottom: 2.25rem;
  }

  .article-detail__header h2 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .article-detail__dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .article-detail__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .article-detail__meta-left {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    min-width: 0;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .tag-list li {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    padding: 0.25rem 0.56rem;
  }

  .article-detail__share {
    flex-shrink: 0;
  }

  .article-detail__export {
    margin-top: 1rem;
    display: flex;
    justify-content: flex-end;
  }

  .share-link {
    display: flex;
    align-items: center;
    color: var(--color-text-muted);
    transition: color 0.2s ease;
  }

  .share-link:hover {
    color: var(--color-text);
  }

  .share-icon {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* ── Header TOC ── */
  .toc-header {
    margin-top: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  .toc-header__summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-text);
    user-select: none;
    transition: background 0.15s ease;
  }

  .toc-header__summary::-webkit-details-marker {
    display: none;
  }

  .toc-header__summary:hover {
    background: var(--color-surface-muted);
  }

  .toc-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: #f97316;
  }

  .toc-chevron {
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .toc-header[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-header__body {
    padding: 0.5rem 1rem 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  /* ── TOC list (shared by header + dialog) ── */
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    counter-reset: toc-h2 toc-h3;
  }

  /* h2 = top-level sections; h3 = sub-sections numbered within their h2 */
  .toc-item--2 {
    counter-increment: toc-h2;
    counter-reset: toc-h3;
  }

  .toc-item--3 {
    counter-increment: toc-h3;
  }

  .toc-link {
    display: block;
    padding: 0.3rem 0.5rem 0.3rem 0.75rem;
    border-left: 2px solid transparent;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.5;
    border-radius: 0 0.35rem 0.35rem 0;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .toc-link::before {
    font-variant-numeric: tabular-nums;
  }

  /* h2: bold orange section number (1., 2., …) */
  .toc-item--2 .toc-link::before {
    content: counter(toc-h2) ".";
    color: #f97316;
    font-weight: 700;
    font-size: 0.8em;
    margin-right: 0.4rem;
  }

  /* h3: muted sub-number scoped to its section (1-1, 1-2, …) */
  .toc-item--3 .toc-link::before {
    content: counter(toc-h2) "-" counter(toc-h3);
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.72em;
    margin-right: 0.4rem;
  }

  .toc-link:hover {
    color: var(--color-text);
    background: var(--color-surface-muted);
    border-left-color: var(--color-border);
  }

  .toc-link--active {
    color: var(--color-text);
    font-weight: 600;
    border-left-color: #f97316;
    background: color-mix(in srgb, #f97316 8%, transparent);
  }

  .toc-item--2 .toc-link {
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* h3: indented and grouped under its h2 by a subtle nesting rail */
  .toc-item--3 .toc-link {
    margin-left: 0.9rem;
    padding-left: 0.7rem;
    font-size: 0.825rem;
    border-left-color: var(--color-border);
  }

  .toc-item--3 .toc-link--active {
    border-left-color: #f97316;
  }

  .toc-item--3 .toc-link--active::before {
    color: #f97316;
  }

  /* Dialog variants */
  .toc-list--dialog .toc-item--2 .toc-link {
    padding: 0.4rem 0.6rem 0.4rem 0.9rem;
    font-size: 0.9rem;
  }

  .toc-list--dialog .toc-item--3 .toc-link {
    margin-left: 1rem;
    padding: 0.35rem 0.6rem 0.35rem 0.8rem;
    font-size: 0.85rem;
  }

  /* ── FAB ── */
  .toc-fab {
    position: fixed;
    bottom: 2rem;
    right: 1.75rem;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 9999px;
    border: 2px solid #f97316;
    background: #111;
    color: #fff;
    cursor: pointer;
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.22), 0 2px 6px rgb(249 115 22 / 0.18);
    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.22s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
    white-space: nowrap;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: inherit;
  }

  .toc-fab svg {
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
    color: #f97316;
  }

  .toc-fab--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .toc-fab:hover {
    border-color: #fb923c;
    background: color-mix(in srgb, #111 82%, #f97316 18%);
    box-shadow:
      0 4px 24px rgb(0 0 0 / 0.3),
      0 0 18px rgb(249 115 22 / 0.4),
      0 0 36px rgb(249 115 22 / 0.18);
    transform: translateY(-1px);
  }

  .toc-fab--visible:hover {
    transform: translateY(-1px);
  }

  /* ── Bottom Sheet Dialog ── */
  @keyframes sheet-up {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 1.5rem));
    }
    to {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }
  }

  .toc-dialog {
    padding: 0;
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    top: auto;
    transform: translateX(-50%);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    width: min(calc(100vw - 2rem), 600px);
    max-height: 70vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow:
      0 8px 40px rgb(0 0 0 / 0.22),
      0 2px 8px rgb(0 0 0 / 0.1);
    margin: 0;
  }

  .toc-dialog[open] {
    animation: sheet-up 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .toc-dialog::backdrop {
    background: rgb(0 0 0 / 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* Top grab handle: keep the orange pill but sit it on the same #111 bar as
     the header so the top of the sheet is one continuous color. */
  .toc-dialog__handle {
    display: flex;
    justify-content: center;
    padding-top: 0.75rem;
    background: #111;
  }

  .toc-dialog__handle::before {
    content: "";
    width: 2.5rem;
    height: 4px;
    background: #f97316;
    border-radius: 9999px;
  }

  .toc-dialog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f97316;
    position: sticky;
    top: 0;
    background: #111;
    z-index: 1;
  }

  .toc-dialog__title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.9rem;
    color: #f97316;
  }

  .toc-dialog__title svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    color: #f97316;
  }

  .toc-dialog__close {
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid #444;
    background: transparent;
    color: #aaa;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .toc-dialog__close svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  .toc-dialog__close:hover {
    background: rgba(255 255 255 / 0.1);
    color: #fff;
  }

  .toc-dialog__body {
    padding: 0.5rem 1rem 0.75rem;
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px));
  }

  /* ── Article content ── */
  .article-content {
    color: var(--color-text);
    font-size: 1.04rem;
    line-height: 1.95;
  }

  .article-content :global(> * + *) {
    margin-top: 1.25rem;
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    margin-top: 2.5rem;
    line-height: 1.35;
    letter-spacing: -0.035em;
  }

  .article-content :global(h2) {
    font-size: 1.65rem;
  }

  .article-content :global(h3) {
    font-size: 1.32rem;
  }

  .article-content :global(p),
  .article-content :global(li) {
