---
import type { Locale } from "@/i18n/config";
import { getUi } from "@/i18n/ui";

interface Props {
  mdHref: string;
  jsonHref: string;
  locale: Locale;
}

const { mdHref, jsonHref, locale } = Astro.props;
const t = getUi(locale);
---

<div
  class="article-export"
  data-md-href={mdHref}
  data-json-href={jsonHref}
  data-label-copied={t.copied}
  data-label-failed={t.copyFailed}
>
  <button type="button" class="article-export__btn" data-export-copy="md">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15V5a2 2 0 0 1 2-2h10" />
    </svg>
    <span class="article-export__label">{t.copyAsMarkdown}</span>
  </button>

  <div class="article-export__menu-wrap">
    <button
      type="button"
      class="article-export__btn article-export__toggle"
      aria-haspopup="true"
      aria-expanded="false"
    >
      <span>{t.exportLabel}</span>
      <svg class="article-export__chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="5 8 10 13 15 8" />
      </svg>
    </button>
    <ul class="article-export__menu" role="menu" aria-label={t.exportMenuLabel} hidden>
      <li role="none">
        <button type="button" role="menuitem" class="article-export__item" data-export-copy="json">
          <span class="article-export__label">{t.copyAsJson}</span>
        </button>
      </li>
      <li role="none">
        <a role="menuitem" class="article-export__item" href={mdHref}>{t.viewMarkdown}</a>
      </li>
      <li role="none">
        <a role="menuitem" class="article-export__item" href={jsonHref}>{t.viewJson}</a>
      </li>
    </ul>
  </div>
</div>

<script>
  function setupArticleExport() {
    const root = document.querySelector<HTMLElement>(".article-export");
    if (!root) return;

    const mdHref = root.dataset.mdHref ?? "";
    const jsonHref = root.dataset.jsonHref ?? "";
    const copiedLabel = root.dataset.labelCopied ?? "Copied";
    const failedLabel = root.dataset.labelFailed ?? "Failed to copy";

    const toggle = root.querySelector<HTMLButtonElement>(".article-export__toggle");
    const menu = root.querySelector<HTMLUListElement>(".article-export__menu");
    const menuItems = Array.from(
      root.querySelectorAll<HTMLElement>(".article-export__menu [role='menuitem']"),
    );

    const closeMenu = (focusToggle = false) => {
      if (!toggle || !menu) return;
      toggle.setAttribute("aria-expanded", "false");
      menu.hidden = true;
      if (focusToggle) toggle.focus();
    };

    const openMenu = () => {
      if (!toggle || !menu) return;
      toggle.setAttribute("aria-expanded", "true");
      menu.hidden = false;
    };

    toggle?.addEventListener("click", () => {
      if (toggle.getAttribute("aria-expanded") === "true") closeMenu();
      else openMenu();
    });

    const onDocClick = (e: MouseEvent) => {
      if (!root.contains(e.target as Node)) closeMenu();
    };
    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
        closeMenu(true);
      }
    };
    document.addEventListener("click", onDocClick);
    document.addEventListener("keydown", onKeydown);

    // Close after activating a "View" link.
    for (const item of menuItems) {
      if (item.tagName === "A") item.addEventListener("click", () => closeMenu());
    }

    let resetTimer = 0;
    const flash = (labelEl: HTMLElement | null, original: string, message: string) => {
      if (!labelEl) return;
      labelEl.textContent = message;
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        labelEl.textContent = original;
      }, 1600);
    };

    const copyButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-export-copy]"),
    );
    for (const btn of copyButtons) {
      btn.addEventListener("click", async () => {
        const href = btn.dataset.exportCopy === "json" ? jsonHref : mdHref;
        const labelEl = btn.querySelector<HTMLElement>(".article-export__label");
        const original = labelEl?.textContent ?? "";
        try {
          const res = await fetch(href);
          if (!res.ok) throw new Error(String(res.status));
          await navigator.clipboard.writeText(await res.text());
          flash(labelEl, original, copiedLabel);
        } catch {
          flash(labelEl, original, failedLabel);
        }
        if (btn.dataset.exportCopy === "json") closeMenu();
      });
    }

    document.addEventListener(
      "astro:before-swap",
      () => {
        document.removeEventListener("click", onDocClick);
        document.removeEventListener("keydown", onKeydown);
        window.clearTimeout(resetTimer);
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", setupArticleExport);
</script>

<style>
  .article-export {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .article-export__btn,
  .article-export__item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    text-decoration: none;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      border-color 0.15s ease;
  }

  .article-export__btn:hover,
  .article-export__item:hover,
  .article-export__btn:focus-visible,
  .article-export__item:focus-visible {
    color: var(--color-text);
    background: var(--color-surface-muted);
    border-color: var(--color-link);
  }

  .article-export__btn svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  .article-export__chevron {
    transition: transform 0.2s ease;
  }

  .article-export__toggle[aria-expanded="true"] .article-export__chevron {
    transform: rotate(180deg);
  }

  .article-export__menu-wrap {
    position: relative;
  }

  .article-export__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 30;
    min-width: 11rem;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
    box-shadow: var(--shadow-soft);
  }

  .article-export__menu[hidden] {
    display: none;
  }

  .article-export__menu .article-export__item {
    width: 100%;
    justify-content: flex-start;
    border: 0;
    background: transparent;
    border-radius: 0.45rem;
    font-weight: 500;
  }

  .article-export__menu .article-export__item:hover,
  .article-export__menu .article-export__item:focus-visible {
    background: var(--color-surface-muted);
    border-color: transparent;
  }
</style>
