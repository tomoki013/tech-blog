---
interface Props {
  mdHref: string;
  title: string;
}

const { mdHref, title } = Astro.props;
---

<div id="webmcp" data-md-href={mdHref} data-title={title} hidden></div>

<script>
  // WebMCP is still an experimental Community Group draft. Prefer the current
  // document.modelContext API and fall back to the older Navigator location for
  // browsers that shipped an earlier draft.
  interface ModelContextTool {
    name: string;
    description: string;
    inputSchema?: unknown;
    annotations?: { readOnlyHint?: boolean; untrustedContentHint?: boolean };
    execute: () => Promise<unknown>;
  }
  interface ModelContext {
    registerTool: (
      tool: ModelContextTool,
      options?: { signal?: AbortSignal },
    ) => Promise<void>;
  }

  const getModelContext = () => {
    const documentContext = (document as unknown as { modelContext?: ModelContext }).modelContext;
    if (documentContext) return documentContext;

    return (navigator as unknown as { modelContext?: ModelContext }).modelContext;
  };

  async function setupWebMcp() {
    const modelContext = getModelContext();
    const root = document.getElementById("webmcp");
    if (!modelContext || !root) return;

    const mdHref = root.dataset.mdHref ?? "";
    const title = root.dataset.title ?? "";
    if (!mdHref) return;

    const controller = new AbortController();

    try {
      await modelContext.registerTool(
        {
          name: "get_current_article_markdown",
          description:
            `Return the full Markdown source (with frontmatter) of the article currently ` +
            `open in this tab${title ? `: "${title}"` : ""}.`,
          inputSchema: { type: "object", properties: {}, additionalProperties: false },
          annotations: { readOnlyHint: true },
          async execute() {
            const res = await fetch(mdHref, { credentials: "same-origin" });
            if (!res.ok) throw new Error(`Failed to fetch Markdown (${res.status})`);
            const text = await res.text();
            return { content: [{ type: "text", text }] };
          },
        },
        { signal: controller.signal },
      );
    } catch {
      controller.abort();
      return;
    }

    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true });
  }

  document.addEventListener("astro:page-load", () => {
    void setupWebMcp();
  });
</script>
