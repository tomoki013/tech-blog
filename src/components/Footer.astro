---
import {
  getDisclaimerPath,
  getLicensePath,
  getPrivacyPath,
  getRssPath,
  type Locale,
} from "@/i18n/config";
import { getUi } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
