---
import {
  getAboutPath,
  getArticlesPath,
  getHomePath,
  getWorksPath,
  type Locale,
} from "@/i18n/config";
import { getUi } from "@/i18n/ui";
import { siteConfig } from "@/site.config";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  alternateHref: string;
}

const { locale, alternateHref } = Astro.props;
const t = getUi(locale);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={getHomePath(locale)} data-astro-prefetch>
      <span>{siteConfig.name[locale]}</span>
      <span class="site-header__author">{siteConfig.author}</span>
    </a>

    <button
      type="button"
      class="site-nav__toggle"
      id="site-nav-toggle"
      aria-label={t.menu}
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <svg class="site-nav__icon site-nav__icon--open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg class="site-nav__icon site-nav__icon--close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <nav id="site-nav" class="site-header__nav" aria-label={t.primaryNavigation}>
      <a href={getHomePath(locale)} data-astro-prefetch>{t.home}</a>
      <a href={getArticlesPath(locale)} data-astro-prefetch>{t.articles}</a>
      <a href={getWorksPath(locale)} data-astro-prefetch>{t.works}</a>
      <a href={getAboutPath(locale)} data-astro-prefetch>{t.about}</a>
    </nav>

    <div class="site-header__actions">
      <LanguageSwitcher locale={locale} alternateHref={alternateHref} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<script>
  const getNavigation = () => {
    const toggle = document.getElementById("site-nav-toggle");
    const nav = document.getElementById("site-nav");
    return { toggle, nav };
  };

  const setNavigationOpen = (open: boolean, restoreFocus = false) => {
    const { toggle } = getNavigation();
    if (!toggle) return;

    toggle.setAttribute("aria-expanded", String(open));
    if (!open && restoreFocus) toggle.focus();
  };

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    const { toggle, nav } = getNavigation();
    if (!toggle || !nav) return;

    if (toggle.contains(target)) {
      setNavigationOpen(toggle.getAttribute("aria-expanded") !== "true");
      return;
    }

    if (nav.contains(target)) {
      if (target instanceof Element && target.closest("a")) setNavigationOpen(false);
      return;
    }

    setNavigationOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const { toggle } = getNavigation();
    if (toggle?.getAttribute("aria-expanded") === "true") {
      setNavigationOpen(false, true);
    }
  });

  document.addEventListener("astro:page-load", () => setNavigationOpen(false));
</script>

<style>
  .site-header__brand {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .site-header__author {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: normal;
  }
</style>
