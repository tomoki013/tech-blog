{
  "name": "tomokichi-engineer-blog",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "astro check && tsc --noEmit",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "security:secrets": "gitleaks git --redact --no-banner",
    "test:security": "node --test scripts/audit-dependencies.test.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "perf:js-budget": "node scripts/check-js-budget.mjs",
    "perf:lhci": "lhci autorun",
    "perf": "pnpm build && pnpm perf:js-budget && pnpm perf:lhci"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "pnpm": {
    "overrides": {
      "@lhci/cli>uuid": "11.1.1",
      "basic-ftp@<6.2.1": "6.2.1",
      "tmp@<0.2.7": "0.2.7"
    }
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "2.4.15",
    "@lhci/cli": "^0.15.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.154.0"
  }
}
